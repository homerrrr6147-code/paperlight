{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperlight",
  "version": "0.1.6",
  "identifier": "dev.paperlight.reader",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Paperlight", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }]
  },
  "bundle": { "active": false }
}
